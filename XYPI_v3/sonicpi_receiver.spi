# XYPI Sonic Pi receiver — simple mirror of supercollider_receiver.scd
#
# Sonic Pi listens on UDP 4560. Start XYPI with:
#   python run.py --osc-port 4560
#
# /xypi/corner  connectionName  soundName  y  x  duration
#
#   y  (0–1)  pitch / brightness  → midi note or cutoff (0–130)
#   x  (0–1)  timbre / pan         → pan or filter cutoff (midi)
#   dur       release length (seconds, clipped per sound)
#
# Note: Sonic Pi cutoff is in MIDI notes (max 130), not Hz like SuperCollider.
#
# Sounds: kick bd snare sd hh hat sine bass harmonic
#
# Spatial channels (experiment_1 / play output='osc'):
#   /xypi/synth   channel  midi  amp  step  x  y
#   /xypi/sample  channel  slot  amp  step  x  y
#   /xypi/step    step  bpm

use_real_time

define :c01 do |v|
  [[v.to_f, 0.0].max, 1.0].min
end

define :linlin do |v, a, b, c, d|
  t = c01((v.to_f - a) / (b - a).to_f)
  c + t * (d - c)
end

define :clip do |v, lo, hi|
  [[v.to_f, lo].max, hi].min
end

# --- corner sounds (same roles as SuperCollider SynthDefs) ---

define :xypi_kick do |y, x, dur|
  rel = clip(dur, 0.05, 1.2)
  note = linlin(y, 0, 1, 36, 52)          # y → low pitch (midi)
  synth :sine, note: note, release: rel, amp: 0.35, pan: linlin(x, 0, 1, -1, 1)
end

define :xypi_snare do |y, x, dur|
  rel = clip(dur, 0.04, 1.5)
  body = linlin(y, 0, 1, 45, 64)          # y → body tone (midi)
  synth :noise, release: rel, amp: 0.17, pan: linlin(x, 0, 1, -0.25, 0.25)
  synth :sine, note: body, release: rel, amp: (1 - c01(x)) * 0.16, pan: linlin(x, 0, 1, -0.25, 0.25)
end

define :xypi_hh do |y, x, dur|
  rel = clip(dur, 0.015, 0.8)
  synth :cnoise, release: rel, amp: 0.13, pan: linlin(x, 0, 1, -0.8, 0.8),
    cutoff: linlin(y, 0, 1, 100, 120)      # y → brightness (midi cutoff)
end

define :xypi_sine do |y, x, dur|
  rel = clip(dur, 0.03, 8.0)
  synth :sine, note: 69, release: rel, amp: 0.15, pan: linlin(x, 0, 1, -0.75, 0.75)
  synth :sine, note: 81, release: rel, amp: c01(x) * 0.033, pan: linlin(x, 0, 1, -0.75, 0.75)
end

define :xypi_bass do |y, x, dur|
  rel = clip(dur, 0.05, 8.0)
  note = linlin(y, 0, 1, 28, 43)          # y → bass pitch (midi)
  synth :saw, note: note, release: rel, amp: 0.18,
    cutoff: linlin(x, 0, 1, 40, 100)      # x → filter (midi cutoff)
end

define :xypi_harmonic do |y, x, dur|
  rel = clip(dur, 0.05, 10.0)
  root = linlin(y, 0, 1, 40, 72)          # y → root pitch (midi)
  synth :sine, note: root, release: rel, amp: 0.12, pan: linlin(c01(x), 0, 1, -1, 1)
  synth :sine, note: root + 7, release: rel, amp: 0.086                   # fifth
  synth :sine, note: root + 12, release: rel, amp: 0.062                  # octave
end

define :xypi_corner do |name, sound, y, x, dur|
  s = sound.to_s.strip.downcase.to_sym
  puts "corner #{name} #{s} y=#{y.to_f.round(2)} x=#{x.to_f.round(2)} dur=#{dur.to_f.round(3)}"
  case s
  when :kick, :bd then xypi_kick(y, x, dur)
  when :snare, :sd then xypi_snare(y, x, dur)
  when :hh, :hat then xypi_hh(y, x, dur)
  when :bass then xypi_bass(y, x, dur)
  when :harmonic then xypi_harmonic(y, x, dur)
  else xypi_sine(y, x, dur)
  end
end

live_loop :xypi_corner do
  name, sound, y, x, dur = sync "/osc*/xypi/corner"
  xypi_corner name, sound, y, x, dur
end

live_loop :xypi_synth do
  name, note, amp, step, x, y = sync "/osc*/xypi/synth"
  puts "synth #{name} midi=#{note.to_i} step=#{step.to_i}"
  synth :tri, note: note.to_i, amp: amp.to_f * 0.4, release: 0.12,
    pan: linlin(x.to_f, 0, 8, -1, 1)
end

live_loop :xypi_sample do
  name, slot, amp, step, x, y = sync "/osc*/xypi/sample"
  s = [:bd_haus, :sn_dolf, :drum_cymbal_closed, :elec_blip][[slot.to_i - 1, 0].max, 3]
  puts "sample #{name} slot=#{slot.to_i} step=#{step.to_i}"
  sample s, amp: amp.to_f * 0.55, pan: linlin(y.to_f, 0, 8, -1, 1)
end

live_loop :xypi_step do
  step, bpm = sync "/osc*/xypi/step"
  use_bpm bpm.to_f
end

puts "XYPI receiver ready — /xypi/corner on UDP 4560"
